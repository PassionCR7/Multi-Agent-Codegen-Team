# 复制本文件为 .env 并填入你的配置

# --- LLM ---
# 任意 OpenAI 兼容端点均可：OpenAI / DeepSeek / 通义千问 / 本地 vLLM 等
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 使用的模型
CODER_MODEL=gpt-4o-mini
CODER_TEMPERATURE=0.2
CODER_TIMEOUT=120

# 置为 1 则强制使用离线 MockLLM（无需任何 API Key 即可跑通全流程）
CODER_MOCK=

# --- 循环控制（防止 agent 互相拉扯导致死循环）---
CODER_MAX_ITER=6
CODER_MAX_BUGFIX=4
# 计划重规划轮次上限（防止用户与 planner 反复拉扯）
CODER_MAX_PLAN=5
# coder 连续未产出代码的上限（兜底"一直交白卷"）
CODER_MAX_CODE_TRIES=3

# --- 按需阅读（coder 读取真实项目文件）---
# 最多追问几轮（每轮可请求一批文件）
CODER_MAX_READ=3
# 每轮最多读取几个文件
CODER_READ_FILES=6
# 单文件体积/行数上限（超出截断）
CODER_READ_BYTES=60000
CODER_READ_LINES=900

# --- 工作区 ---
CODER_WORKSPACE=_agent_workspace

# --- 模块拆分与跨模块对账 ---
# 计划里文件数达到该阈值时，启用"按模块分段生成 + 对账"
CODER_SUBTASK_THRESHOLD=2
# 单任务最多处理的模块数
CODER_SUBTASK_MAX=8
# 对账后最多允许的修补轮次
CODER_RECONCILE_ROUNDS=1
